# Bridge-enabled operator image.
#
# Identical to the default Dockerfile except it builds the SPA and compiles the
# manager with the `bridge` Go build tag, so the bridge (backend-for-frontend)
# server and its embedded SPA are included. The default Dockerfile produces the
# public image without the bridge.

# Global ARG (must be declared before the first FROM to be usable in later FROMs).
ARG BUILD_IMAGE=docker.io/golang:1.26

# Build the bridge SPA. It is embedded into the manager binary via go:embed
# (internal/bridge/static.go), so it must be built before the Go build runs.
FROM docker.io/node:26-alpine@sha256:aadf416b2cdce311a8811ba3f0608a61b77dbf997500e2eafe781b51f6a0b019 AS webbuilder
WORKDIR /web
COPY internal/bridge/web/package.json internal/bridge/web/package-lock.json ./
RUN npm ci
COPY internal/bridge/web/ ./
# The SPA bakes the chart versions in at build time (see vite.config.ts), from the
# same file the image fetches its charts with.
COPY CHART_VERSIONS ./CHART_VERSIONS
RUN npx --yes openapi-typescript openapi.yaml -o src/lib/api/schema.d.ts && npm run build

# Build the manager binary
FROM --platform=${BUILDPLATFORM} ${BUILD_IMAGE} AS builder
WORKDIR /workspace

# Copy in any existing Go cache, and download
# any missing dependencies.
ENV GOPATH=/go
COPY .go/pkg/mod/ /go/pkg/mod/
COPY go.mod go.sum ./
RUN go mod download

# Copy the go source
COPY cmd/manager/ cmd/manager/
COPY api/ api/
COPY helm/ helm/
COPY pkg/ pkg/
COPY controllers/ controllers/
COPY internal/ internal/

# Bring in the built SPA so //go:embed all:web/dist (internal/bridge/static.go) resolves.
COPY --from=webbuilder /web/dist internal/bridge/web/dist

# Build with the `bridge` tag so the bridge server is wired into the manager.
ARG TARGETOS
ARG TARGETARCH

RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} GO111MODULE=on go build -a -tags bridge -o manager ./cmd/manager

# Use ubi micro as base image to package the manager binary
# Refer to https://www.redhat.com/en/blog/introduction-ubi-micro for more details
FROM registry.access.redhat.com/ubi9-micro:9.8@sha256:f332c99eb8f798a8486821c91937f10ad64ee83d7e739303be2df051040918f6

LABEL name=gitlab-operator \
      vendor='GitLab, Inc.' \
      description='Operator to deploy GitLab instances (bridge-enabled build)' \
      summary='GitLab is a DevOps lifecycle tool that provides Git repositories' \
      maintainer='GitLab Self-Managed'

# Allow the chart directory to be overwritten with --build-arg
ARG CHART_DIR="/charts"

ENV USER_UID=1001 \
    HELM_CHARTS=${CHART_DIR}

# ADD GITLAB LICENSE
COPY LICENSE /licenses/GITLAB

# Add pre-packaged charts for the operator to deploy
COPY charts ${CHART_DIR}

WORKDIR /
COPY --from=builder /workspace/manager .
USER ${USER_UID}

ENTRYPOINT ["/manager"]
